VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Never add service-role key here.

# Custom OIDC provider name as configured in the Supabase dashboard.
# Format: custom:<name>  e.g.  custom:central-admin
# If omitted, the SSO button is hidden and email/password login still works.
VITE_SSO_PROVIDER=custom:central-admin
